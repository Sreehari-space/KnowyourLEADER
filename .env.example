# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Google Gemini API keys, used by scripts/geminiRotator.ts.
# At least GEMINI_KEY_1 is required; extra keys (up to _9) are rotated
# round-robin so the pipeline survives per-key 429 rate limits.
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=

# Optional. Only fetch MLA Watch news published on or after this date.
# MLA_WATCH_SINCE=2026-01-01

# Optional. Directory of source affidavit files for npm run build:affidavits.
# AFFIDAVIT_DIR=
