{
  "name": "tnleaders",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3001 --host=0.0.0.0",
    "build": "node scripts/generate_sitemap.js && node scripts/splitCandidates.cjs && node scripts/buildAffidavits.cjs && node scripts/buildPropertyMap.cjs && vite build",
    "build:affidavits": "node scripts/buildAffidavits.cjs",
    "build:propertymap": "node scripts/buildPropertyMap.cjs",
    "verify:affidavits": "node scripts/verifyAffidavitCoverage.cjs",
    "analyse:property-links": "node scripts/findPropertyLinks.cjs",
    "analyse:flags": "node scripts/findDeclarationFlags.cjs",
    "build:flags": "node scripts/buildDeclarationFlags.cjs",
    "audit:layout": "node scripts/auditLayout.mjs",
    "verify:shape": "node scripts/verifyAffidavitShape.cjs",
    "repair:contracts2021": "node scripts/repairAffidavit2021Contracts.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "pipeline": "node --loader ts-node/esm scripts/runPipeline.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.19.20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
